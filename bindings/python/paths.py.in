"""Hardcoded paths.

Paths starting with lower case `dlite_` are relative to the sources or build
root.

Paths starting with upper case `DLITE_` are relative to the install root.
"""

# Build and source root
dlite_BUILD_ROOT = '@dlite_BINARY_DIR@'
dlite_SOURCE_ROOT = '@dlite_SOURCE_DIR@'

# Relative to source root
dlite_LD_LIBRARY_PATH = '@dlite_LD_LIBRARY_PATH@'
dlite_PYTHONPATH = '@dlite_PYTHONPATH@'
dlite_STORAGE_PLUGINS = '@dlite_STORAGE_PLUGINS@'
dlite_MAPPING_PLUGINS = '@dlite_MAPPING_PLUGINS@'
dlite_PYTHON_STORAGE_PLUGINS = '@dlite_PYTHON_STORAGE_PLUGINS@'
dlite_PYTHON_MAPPING_PLUGINS = '@dlite_PYTHON_MAPPING_PLUGINS@'
dlite_PYTHON_PROTOCOL_PLUGINS = '@dlite_PYTHON_PROTOCOL_PLUGINS@'
dlite_TEMPLATES = '@dlite_TEMPLATES@'
dlite_STORAGES = '@dlite_STORAGES@'

# Relative to install root
DLITE_INSTALL_ROOT = '@CMAKE_INSTALL_PREFIX@'
DLITE_PKG_ROOT = '@DLITE_PKG_ROOT@'
DLITE_INCLUDE_DIRS = '@CMAKE_INSTALL_PREFIX@/@DLITE_INCLUDE_DIRS@'
DLITE_LIBRARY_DIR = '@CMAKE_INSTALL_PREFIX@/@DLITE_INCLIDE_DIR@'
DLITE_RUNTIME_DIR = '@CMAKE_INSTALL_PREFIX@/@DLITE_RUNTIME_DIR@'
DLITE_DATA_DIR = '@CMAKE_INSTALL_PREFIX@/@DLITE_DATA_DIR@'
DLITE_INSTALL_CMAKE_DIR = '@CMAKE_INSTALL_PREFIX@/@DLITE_INSTALL_CMAKE_DIR@'

DLITE_PYTHONPATH = '@DLITE_PYTHONPATH@'
DLITE_STORAGE_PLUGINS = '@DLITE_STORAGE_PLUGINS@'
DLITE_MAPPING_PLUGINS = '@DLITE_MAPPING_PLUGINS@'
DLITE_PYTHON_STORAGE_PLUGINS = '@DLITE_PYTHON_STORAGE_PLUGINS@'
DLITE_PYTHON_MAPPING_PLUGINS = '@DLITE_PYTHON_MAPPING_PLUGINS@'
DLITE_PYTHON_PROTOCOL_PLUGINS = '@DLITE_PYTHON_PROTOCOL_PLUGINS@'
DLITE_TEMPLATES = '@DLITE_TEMPLATES@'
DLITE_STORAGES = '@DLITE_STORAGES@'
